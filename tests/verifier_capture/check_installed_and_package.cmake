cmake_minimum_required(VERSION 3.20)

file(READ "${CAPTURE_RECEIPT}" _expected LIMIT 65)
if(CMAKE_HOST_WIN32)
  set(_helper_name "anosecurekit-verifier-capture.exe")
else()
  set(_helper_name "anosecurekit-verifier-capture")
endif()

function(check_inventory prefix result)
  file(GLOB_RECURSE _adapters LIST_DIRECTORIES false "${prefix}/check_release_evidence_verifier.cmake")
  list(FILTER _adapters INCLUDE REGEX "/cmake/anosecurekitEnterprise/check_release_evidence_verifier\\.cmake$")
  list(LENGTH _adapters _count)
  if(NOT _count EQUAL 1)
    message(FATAL_ERROR "Expected one installed verifier adapter in ${prefix}")
  endif()
  list(GET _adapters 0 _adapter)
  get_filename_component(_directory "${_adapter}" DIRECTORY)
  set(_helper "${_directory}/${_helper_name}")
  foreach(_entry IN ITEMS "${_adapter}" "${_helper}" "${_helper}.sha256")
    if(NOT EXISTS "${_entry}" OR IS_DIRECTORY "${_entry}" OR IS_SYMLINK "${_entry}")
      message(FATAL_ERROR "Missing or unsafe capture inventory entry in ${prefix}")
    endif()
  endforeach()
  file(READ "${_helper}.sha256" _packaged LIMIT 65)
  file(SHA256 "${_helper}" _actual)
  if(NOT _actual STREQUAL _expected OR NOT _packaged STREQUAL _expected)
    message(FATAL_ERROR "Capture inventory differs from the trusted build receipt in ${prefix}")
  endif()
  set("${result}" "${_directory}" PARENT_SCOPE)
endfunction()

function(check_installed_probe expected_exit diagnostic)
  execute_process(COMMAND "${CMAKE_COMMAND}" ${ARGN}
    "-DVERIFIER_EXECUTABLE=${FIXTURE}" "-DTEST_VERIFIER_SCRIPT=${CMAKE_CURRENT_LIST_FILE}"
    -DALLOW_TEST_VERIFIER=ON -DPROBE_ONLY=ON -DREQUIRE_VERIFIED=ON
    -P "${_probe}/check_release_evidence_verifier.cmake"
    RESULT_VARIABLE _exit OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 5)
  string(REGEX REPLACE "[ \t\r\n]+" " " _log "${_out}${_err}")
  string(FIND "${_log}" "${diagnostic}" _observed)
  if(NOT "${_exit}" STREQUAL "${expected_exit}" OR _observed EQUAL -1
     OR NOT _log MATCHES "customer_release_ready: false")
    message(FATAL_ERROR "Installed helper probe failed: expected ${expected_exit} and '${diagnostic}'\n${_log}")
  endif()
endfunction()

if(DEFINED INSTALLED_ROOT)
  check_inventory("${INSTALLED_ROOT}" _installed)
  get_filename_component(_scratch "${INSTALLED_ROOT}" DIRECTORY)
  set(_probe "${_scratch}/capture installed probe")
  file(MAKE_DIRECTORY "${_probe}")
  file(COPY "${_installed}/check_release_evidence_verifier.cmake"
    "${_installed}/${_helper_name}" "${_installed}/${_helper_name}.sha256" DESTINATION "${_probe}")

  check_installed_probe(0 "capability_status: available" "-DVERIFIER_CAPTURE_EXPECTED_SHA256=${_expected}")
  check_installed_probe(1 "trusted verifier capture identity is missing or unsafe")
  string(REPEAT "0" 64 _wrong)
  check_installed_probe(1 "verifier capture helper identity mismatch" "-DVERIFIER_CAPTURE_EXPECTED_SHA256=${_wrong}")
  file(REMOVE "${_probe}/${_helper_name}")
  check_installed_probe(1 "verifier capture helper is missing or unsafe" "-DVERIFIER_CAPTURE_EXPECTED_SHA256=${_expected}")
  file(REMOVE_RECURSE "${_probe}")
  message(STATUS "Installed verifier capture identity and negative probes passed")
elseif(DEFINED DELIVERY_ROOT)
  check_inventory("${DELIVERY_ROOT}/stage" _stage)
  foreach(_suffix IN ITEMS ".zip" ".tar.gz")
    file(GLOB _roots LIST_DIRECTORIES true "${DELIVERY_ROOT}/extract/*${_suffix}/anosecurekit-enterprise-*")
    list(LENGTH _roots _count)
    if(NOT _count EQUAL 1)
      message(FATAL_ERROR "Expected one extracted Enterprise ${_suffix} delivery")
    endif()
    list(GET _roots 0 _root)
    check_inventory("${_root}" _archive)
  endforeach()
  message(STATUS "ZIP and TGZ capture inventories match the trusted build receipt (static checks)")
else()
  message(FATAL_ERROR "INSTALLED_ROOT or DELIVERY_ROOT is required")
endif()
