@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(anosecurekit @ANOSECUREKIT_ENTERPRISE_COMMUNITY_VERSION@ EXACT CONFIG REQUIRED)

set(ANOSECUREKIT_ENTERPRISE_PACKAGE_VERSION "@PROJECT_VERSION@")
set(ANOSECUREKIT_ENTERPRISE_PACKAGE_BACKEND_PROFILE "@ANOSECUREKIT_ENTERPRISE_CRYPTO_BACKEND@")
set(ANOSECUREKIT_ENTERPRISE_COMMUNITY_VERSION "@ANOSECUREKIT_ENTERPRISE_COMMUNITY_VERSION@")
set(ANOSECUREKIT_ENTERPRISE_QUALIFICATION_STATUS "local-pass-remote-deferred")
set(ANOSECUREKIT_ENTERPRISE_EVIDENCE_BUNDLE_STATUS "present")
set(ANOSECUREKIT_ENTERPRISE_ATTESTATION_GENERATION_STATUS "configured")
set(ANOSECUREKIT_ENTERPRISE_VERIFIER_BACKEND_STATUS "unavailable")
set(ANOSECUREKIT_ENTERPRISE_VERIFIER_BACKEND_ID "none")
set(ANOSECUREKIT_ENTERPRISE_VERIFIER_VERSION "unavailable")
set(ANOSECUREKIT_ENTERPRISE_VERIFIER_VERSION_POLICY ">=2.49.0,<3.0.0")
set(ANOSECUREKIT_ENTERPRISE_RELEASE_EVIDENCE_VERIFIER_SCRIPT
  "${CMAKE_CURRENT_LIST_DIR}/check_release_evidence_verifier.cmake")
set(ANOSECUREKIT_ENTERPRISE_STRUCTURAL_EVIDENCE_STATUS "unavailable")
set(ANOSECUREKIT_ENTERPRISE_CRYPTOGRAPHIC_EVIDENCE_STATUS "unavailable")
set(ANOSECUREKIT_ENTERPRISE_TRUSTED_EVIDENCE_STATUS "unavailable")
set(ANOSECUREKIT_ENTERPRISE_RELEASE_AUTHORIZATION_STATUS "denied-or-unavailable")
set(ANOSECUREKIT_ENTERPRISE_RELEASE_AUTHORIZATION_REQUIRED TRUE)
set(ANOSECUREKIT_ENTERPRISE_CUSTOMER_RELEASE_READY FALSE)

if(NOT ANOSECUREKIT_ENTERPRISE_PACKAGE_BACKEND_PROFILE STREQUAL "openssl")
  set(anosecurekitEnterprise_FOUND FALSE)
  set(anosecurekitEnterprise_NOT_FOUND_MESSAGE
    "This installed AnoSecureKit Enterprise package was not produced from the supported OpenSSL delivery profile")
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/anosecurekitEnterpriseTargets.cmake")
check_required_components(anosecurekitEnterprise)
