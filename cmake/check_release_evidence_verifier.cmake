cmake_minimum_required(VERSION 3.20)

# A failure before the result is written must not leave an earlier success.
foreach(_output IN ITEMS VERIFIER_TEXT_OUTPUT VERIFIER_JSON_OUTPUT)
  if(DEFINED ${_output} AND NOT "${${_output}}" STREQUAL "")
    file(REMOVE "${${_output}}")
  endif()
endforeach()

if(NOT DEFINED REQUIRE_VERIFIED)
  set(REQUIRE_VERIFIED OFF)
endif()
if(NOT DEFINED PROBE_ONLY)
  set(PROBE_ONLY OFF)
endif()
if(NOT DEFINED ALLOW_TEST_VERIFIER)
  set(ALLOW_TEST_VERIFIER OFF)
endif()
if(NOT DEFINED VERIFIER_TIMEOUT_SECONDS)
  set(VERIFIER_TIMEOUT_SECONDS 15)
endif()
if(NOT DEFINED VERIFIER_MAX_OUTPUT_BYTES)
  set(VERIFIER_MAX_OUTPUT_BYTES 1048576)
endif()
if(NOT VERIFIER_TIMEOUT_SECONDS MATCHES "^[1-9][0-9]*$"
   OR VERIFIER_TIMEOUT_SECONDS GREATER 60)
  message(FATAL_ERROR "VERIFIER_TIMEOUT_SECONDS must be an integer from 1 to 60")
endif()
if(NOT VERIFIER_MAX_OUTPUT_BYTES MATCHES "^[1-9][0-9]*$"
   OR VERIFIER_MAX_OUTPUT_BYTES GREATER 1048576)
  message(FATAL_ERROR "VERIFIER_MAX_OUTPUT_BYTES must be an integer from 1 to 1048576")
endif()

set(_backend_id none)
set(_path_source none)
set(_version unavailable)
set(_version_policy unavailable)
set(_backend unavailable)
set(_capability unavailable)
set(_verification unavailable)
set(_subject_digest unavailable)
set(_source_repository unavailable)
set(_source_revision unavailable)
set(_attestation_reference unavailable)
set(_trust_domain unavailable)
set(_reason "verifier executable unavailable")
set(_test_mode false)
if(DEFINED TEST_VERIFIER_SCRIPT AND NOT TEST_VERIFIER_SCRIPT STREQUAL "")
  set(_test_mode true)
endif()
if(DEFINED ATTESTATION_GENERATION_STATUS AND NOT ATTESTATION_GENERATION_STATUS STREQUAL "")
  set(_attestation_generation "${ATTESTATION_GENERATION_STATUS}")
else()
  set(_attestation_generation configured)
endif()
if(NOT _attestation_generation MATCHES
    "^(configured|generated|unavailable|blocked-external)$")
  message(FATAL_ERROR "Unsupported ATTESTATION_GENERATION_STATUS")
endif()

function(_verifier_write path content)
  if(path STREQUAL "")
    return()
  endif()
  get_filename_component(_directory "${path}" DIRECTORY)
  file(MAKE_DIRECTORY "${_directory}")
  file(REMOVE "${path}.tmp")
  file(WRITE "${path}.tmp" "${content}")
  file(RENAME "${path}.tmp" "${path}")
endfunction()

macro(_verifier_finish fail)
  string(TIMESTAMP _timestamp "%Y-%m-%dT%H:%M:%SZ" UTC)
  set(_text
    "attestation_generation: ${_attestation_generation}\n"
    "verifier_backend: ${_backend}\n"
    "verifier_backend_id: ${_backend_id}\n"
    "executable_path_source: ${_path_source}\n"
    "verifier_version: ${_version}\n"
    "version_policy: ${_version_policy}\n"
    "capability_status: ${_capability}\n"
    "verification_status: ${_verification}\n"
    "subject_digest: ${_subject_digest}\n"
    "source_repository: ${_source_repository}\n"
    "source_revision: ${_source_revision}\n"
    "attestation_reference: ${_attestation_reference}\n"
    "trust_domain: ${_trust_domain}\n"
    "verification_timestamp: ${_timestamp}\n"
    "test_mode: ${_test_mode}\n"
    "cryptographic_evidence: ${_verification}\n"
    "trusted_evidence: unavailable\n"
    "release_authorization: denied-or-unavailable\n"
    "customer_release_ready: false\n")
  string(REPLACE ";" "" _text "${_text}")
  if(DEFINED VERIFIER_TEXT_OUTPUT)
    _verifier_write("${VERIFIER_TEXT_OUTPUT}" "${_text}")
  endif()

  set(_json
    "{\"attestation_generation\":\"${_attestation_generation}\""
    ",\"verifier_backend\":\"${_backend}\""
    ",\"verifier_backend_id\":\"${_backend_id}\""
    ",\"executable_path_source\":\"${_path_source}\""
    ",\"verifier_version\":\"${_version}\""
    ",\"version_policy\":\"${_version_policy}\""
    ",\"capability_status\":\"${_capability}\""
    ",\"verification_status\":\"${_verification}\""
    ",\"subject_digest\":\"${_subject_digest}\""
    ",\"source_repository\":\"${_source_repository}\""
    ",\"source_revision\":\"${_source_revision}\""
    ",\"attestation_reference\":\"${_attestation_reference}\""
    ",\"trust_domain\":\"${_trust_domain}\""
    ",\"verification_timestamp\":\"${_timestamp}\""
    ",\"test_mode\":${_test_mode}"
    ",\"cryptographic_evidence\":\"${_verification}\""
    ",\"trusted_evidence\":\"unavailable\""
    ",\"release_authorization\":\"denied-or-unavailable\""
    ",\"customer_release_ready\":false}\n")
  string(REPLACE ";" "" _json "${_json}")
  if(DEFINED VERIFIER_JSON_OUTPUT)
    _verifier_write("${VERIFIER_JSON_OUTPUT}" "${_json}")
  endif()

  foreach(_line IN LISTS _text)
    string(REGEX REPLACE "\n$" "" _line "${_line}")
    if(NOT _line STREQUAL "")
      message(STATUS "${_line}")
    endif()
  endforeach()
  if(${fail})
    message(FATAL_ERROR "Release evidence verifier failed: ${_reason}")
  endif()
  return()
endmacro()

# string(JSON) collapses duplicate members. Scan the original tokens first,
# decoding each member name before comparing it with its siblings.
function(_verifier_check_json_members json reason)
  set("${reason}" "malformed machine-readable verifier output" PARENT_SCOPE)

  # Reserve bytes forbidden in JSON to protect list punctuation and escapes.
  # ASCII 45 is the hyphen in the ranges 1–8 and 14–31.
  string(ASCII 1 45 8 11 12 14 45 31 _controls)
  if(json MATCHES "[${_controls}]")
    return()
  endif()
  string(ASCII 1 _array_open)
  string(ASCII 2 _array_close)
  string(ASCII 3 _semicolon)
  string(ASCII 4 _escape_marker)
  string(ASCII 5 _escaped_quote)
  string(ASCII 6 _escaped_backslash)
  string(REPLACE "[" "${_array_open}" _encoded "${json}")
  string(REPLACE "]" "${_array_close}" _encoded "${_encoded}")
  string(REPLACE ";" "${_semicolon}" _encoded "${_encoded}")

  # Consume valid escapes left to right so a single character class can scan
  # strings, even ones with many escapes. A leftover backslash is invalid.
  set(_hex "[0-9a-fA-F]")
  string(REGEX REPLACE "\\\\([\"\\\\/bfnrt]|u${_hex}${_hex}${_hex}${_hex})"
    "${_escape_marker}\\1" _encoded "${_encoded}")
  string(REPLACE "${_escape_marker}\"" "${_escaped_quote}" _encoded "${_encoded}")
  string(REPLACE "${_escape_marker}\\" "${_escaped_backslash}" _encoded "${_encoded}")
  set(_string "\"[^\"\\\\\t\r\n]*\"")
  set(_number "-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?")
  string(REGEX MATCHALL
    "${_string}|${_number}|true|false|null|[{}:,${_array_open}${_array_close}]|[ \t\r\n]+"
    _tokens "${_encoded}")
  list(JOIN _tokens "" _joined)
  if(NOT _joined STREQUAL _encoded)
    return()
  endif()

  set(_depth 0)
  set(_state_0 root-value)
  set(_object_id 0)
  set(_unexpected_runner FALSE)
  foreach(_token IN LISTS _tokens)
    if(_token MATCHES "^[ \t\r\n]")
      continue()
    endif()
    set(_state "${_state_${_depth}}")
    if((_state MATCHES "^object-(first|end)$" AND _token STREQUAL "}")
       OR (_state MATCHES "^array-(first|end)$" AND _token STREQUAL _array_close))
      math(EXPR _depth "${_depth} - 1")
    elseif(_state STREQUAL "object-end" OR _state STREQUAL "array-end")
      if(NOT _token STREQUAL ",")
        return()
      endif()
      if(_state STREQUAL "object-end")
        set("_state_${_depth}" object-key)
      else()
        set("_state_${_depth}" array-value)
      endif()
    elseif(_state STREQUAL "colon")
      if(NOT _token STREQUAL ":")
        return()
      endif()
      set("_state_${_depth}" object-value)
    elseif(_state STREQUAL "object-first" OR _state STREQUAL "object-key")
      if(NOT _token MATCHES "^\"")
        return()
      endif()
      string(REPLACE "${_array_open}" "[" _token "${_token}")
      string(REPLACE "${_array_close}" "]" _token "${_token}")
      string(REPLACE "${_semicolon}" ";" _token "${_token}")
      string(REPLACE "${_escaped_quote}" [=[\"]=] _token "${_token}")
      string(REPLACE "${_escaped_backslash}" [=[\\]=] _token "${_token}")
      string(REPLACE "${_escape_marker}" [=[\]=] _token "${_token}")
      string(JSON _key ERROR_VARIABLE _key_error GET "[${_token}]" 0)
      if(_key_error)
        return()
      endif()
      string(SHA256 _key_hash "${_key}")
      set(_member "_seen_${_object_${_depth}}_${_key_hash}")
      if(DEFINED "${_member}")
        set("${reason}" "duplicate JSON object member" PARENT_SCOPE)
        return()
      endif()
      set("${_member}" TRUE)
      set("_key_${_depth}" "${_key}")
      set("_state_${_depth}" colon)

      # While inside a member value, each ancestor retains its own member name.
      # The root array contains result entries. The only allowed member paths
      # within an entry are verificationResult.signature.certificate and
      # verificationResult.verifiedIdentity.
      if(_key STREQUAL "runnerEnvironment")
        if(NOT (_state_1 STREQUAL "array-end" AND _key_2 STREQUAL "verificationResult"
            AND ((_depth EQUAL 5 AND _key_3 STREQUAL "signature" AND _key_4 STREQUAL "certificate")
              OR (_depth EQUAL 4 AND _key_3 STREQUAL "verifiedIdentity"))))
          set(_unexpected_runner TRUE)
        endif()
      endif()
    else()
      if(_state STREQUAL "root-value")
        set(_state_0 root-end)
      elseif(_state MATCHES "^array-(first|value)$")
        set("_state_${_depth}" array-end)
      elseif(_state STREQUAL "object-value")
        set("_state_${_depth}" object-end)
      else()
        return()
      endif()
      if(_token STREQUAL "{" OR _token STREQUAL _array_open)
        math(EXPR _depth "${_depth} + 1")
        # Leave room for a scalar at the bundled JSON decoder's 1000-node
        # stack limit. Reject before passing the document to string(JSON).
        if(_depth GREATER 999)
          set("${reason}" "machine-readable verifier output exceeds JSON nesting limit" PARENT_SCOPE)
          return()
        endif()
        set("_key_${_depth}" "")
        if(_token STREQUAL "{")
          math(EXPR _object_id "${_object_id} + 1")
          set("_object_${_depth}" "${_object_id}")
          set("_state_${_depth}" object-first)
        else()
          set("_state_${_depth}" array-first)
        endif()
      elseif(NOT _token MATCHES "^[\"0-9tfn-]")
        return()
      endif()
    endif()
  endforeach()

  if(_depth EQUAL 0 AND _state_0 STREQUAL "root-end")
    if(_unexpected_runner)
      set("${reason}" "unexpected runnerEnvironment path" PARENT_SCOPE)
    else()
      set("${reason}" "" PARENT_SCOPE)
    endif()
  endif()
endfunction()

function(_verifier_capture_identity reason)
  set("${reason}" "verifier capture helper is missing or unsafe" PARENT_SCOPE)
  if(CMAKE_HOST_WIN32)
    set(_name "anosecurekit-verifier-capture.exe")
  else()
    set(_name "anosecurekit-verifier-capture")
  endif()
  if(DEFINED VERIFIER_CAPTURE_EXECUTABLE)
    set(_path "${VERIFIER_CAPTURE_EXECUTABLE}")
  else()
    set(_path "${CMAKE_CURRENT_LIST_DIR}/${_name}")
  endif()
  get_filename_component(_basename "${_path}" NAME)
  if(NOT IS_ABSOLUTE "${_path}" OR NOT _basename STREQUAL _name)
    return()
  endif()
  if(NOT EXISTS "${_path}" OR IS_DIRECTORY "${_path}" OR IS_SYMLINK "${_path}")
    return()
  endif()
  file(REAL_PATH "${_path}" _real_path)
  if(NOT _path STREQUAL _real_path)
    return()
  endif()
  set("${reason}" "trusted verifier capture identity is missing or unsafe" PARENT_SCOPE)
  if(DEFINED VERIFIER_CAPTURE_BUILD_RECEIPT)
    # Only callers that supply an explicit controlled build executable and
    # its separately designated receipt can use this form of provenance.
    set(_receipt "${VERIFIER_CAPTURE_BUILD_RECEIPT}")
    if(NOT DEFINED VERIFIER_CAPTURE_EXECUTABLE OR DEFINED VERIFIER_CAPTURE_EXPECTED_SHA256
       OR NOT IS_ABSOLUTE "${_receipt}" OR NOT EXISTS "${_receipt}"
       OR IS_DIRECTORY "${_receipt}" OR IS_SYMLINK "${_receipt}")
      return()
    endif()
    file(REAL_PATH "${_receipt}" _real_receipt)
    file(SIZE "${_receipt}" _receipt_size)
    if(NOT _receipt STREQUAL _real_receipt OR NOT _receipt_size EQUAL 64)
      return()
    endif()
    file(READ "${_receipt}" _expected LIMIT 64)
  else()
    set(_expected "${VERIFIER_CAPTURE_EXPECTED_SHA256}")
  endif()
  string(LENGTH "${_expected}" _expected_length)
  if(NOT _expected_length EQUAL 64 OR NOT _expected MATCHES "^[0-9a-f]+$")
    return()
  endif()
  set("${reason}" "verifier capture helper identity mismatch" PARENT_SCOPE)
  file(SIZE "${_path}" _binary_size)
  if(_binary_size LESS 1)
    return()
  endif()
  file(SHA256 "${_path}" _actual)
  if(NOT _expected STREQUAL _actual)
    return()
  endif()
  set(_capture_executable "${_path}" PARENT_SCOPE)
  set("${reason}" "" PARENT_SCOPE)
endfunction()

function(_verifier_append_arguments destination)
  set(_encoded "${${destination}}")
  math(EXPR _last "${ARGC} - 1")
  foreach(_index RANGE 1 ${_last})
    # A nonempty ASCII item for every argument, including empty values and
    # values containing CMake list separators or Windows quoting characters.
    string(HEX "${ARGV${_index}}" _hex)
    list(APPEND _encoded "x${_hex}")
  endforeach()
  set("${destination}" "${_encoded}" PARENT_SCOPE)
endfunction()

function(_verifier_capture mode result stdout stderr)
  math(EXPR _milliseconds "1000 * ${VERIFIER_TIMEOUT_SECONDS}")
  math(EXPR _watchdog "${VERIFIER_TIMEOUT_SECONDS} + 3")
  set(_capture_status 65 PARENT_SCOPE)
  execute_process(
    COMMAND "${_capture_executable}" capture "${_milliseconds}" "${VERIFIER_MAX_OUTPUT_BYTES}"
      "${mode}" ${ARGN}
    TIMEOUT "${_watchdog}" ENCODING NONE
    RESULT_VARIABLE _status OUTPUT_VARIABLE _bridge ERROR_QUIET)
  if(NOT _status STREQUAL "0")
    set(_capture_status "${_status}" PARENT_SCOPE)
    return()
  endif()
  math(EXPR _bridge_limit "12 * ${VERIFIER_MAX_OUTPUT_BYTES} + 128")
  string(LENGTH "${_bridge}" _length)
  if(_length GREATER _bridge_limit)
    return()
  endif()

  # Enforce one complete record with exactly four fields before decoding.
  # Removing escaped backslash pairs first preserves the quote boundaries.
  string(REPLACE [[\\]] "" _layout "${_bridge}")
  string(REPLACE [[\"]] "" _layout "${_layout}")
  string(REGEX REPLACE [["[^"]*"]] "\"\"" _layout "${_layout}")
  if(NOT _layout MATCHES "^[{]\"\":\"\",\"\":(0|[1-9][0-9]*),\"\":\"\",\"\":\"\"[}]\n$")
    return()
  endif()
  foreach(_member IN ITEMS protocol exit stdout stderr)
    string(JSON _type ERROR_VARIABLE _error TYPE "${_bridge}" "${_member}")
    if(_error OR (_member STREQUAL "exit" AND NOT _type STREQUAL "NUMBER")
       OR (NOT _member STREQUAL "exit" AND NOT _type STREQUAL "STRING"))
      return()
    endif()
    string(JSON _${_member} ERROR_VARIABLE _error GET "${_bridge}" "${_member}")
    if(_error)
      return()
    endif()
  endforeach()
  if(NOT _protocol STREQUAL "ask-verifier-capture-v1" OR NOT _exit MATCHES "^[0-9]+$")
    return()
  endif()
  string(LENGTH "${_stdout}" _out_size)
  string(LENGTH "${_stderr}" _err_size)
  if(_out_size GREATER VERIFIER_MAX_OUTPUT_BYTES OR _err_size GREATER VERIFIER_MAX_OUTPUT_BYTES)
    return()
  endif()
  set(_capture_status 0 PARENT_SCOPE)
  set("${result}" "${_exit}" PARENT_SCOPE)
  set("${stdout}" "${_stdout}" PARENT_SCOPE)
  set("${stderr}" "${_stderr}" PARENT_SCOPE)
endfunction()

macro(_verifier_require_capture label timeout_reason)
  if(NOT _capture_status STREQUAL "0")
    set(_backend error)
    set(_verification rejected)
    if(NOT _capability STREQUAL "available")
      set(_capability error)
      set(_version_policy error)
    endif()
    if(_capture_status STREQUAL "66")
      set(_reason "${label} exceeded verifier output limit")
    elseif(_capture_status STREQUAL "67")
      set(_reason "${timeout_reason}")
    elseif(_capture_status STREQUAL "68")
      set(_reason "${label} contains invalid verifier output bytes")
    elseif(_capture_status STREQUAL "70")
      set(_reason "malformed machine-readable verifier output")
    else()
      set(_reason "${label} failed at the verifier capture boundary")
    endif()
    _verifier_finish(TRUE)
  endif()
endmacro()

if(_test_mode AND NOT ALLOW_TEST_VERIFIER)
  set(_backend error)
  set(_capability error)
  set(_reason "test verifier is forbidden outside explicit test mode")
  _verifier_finish(TRUE)
endif()

if(DEFINED VERIFIER_EXECUTABLE AND NOT VERIFIER_EXECUTABLE STREQUAL "")
  set(_verifier "${VERIFIER_EXECUTABLE}")
  set(_path_source user-specified)
elseif(DEFINED INSTALLED_VERIFIER_EXECUTABLE
       AND NOT INSTALLED_VERIFIER_EXECUTABLE STREQUAL "")
  set(_verifier "${INSTALLED_VERIFIER_EXECUTABLE}")
  set(_path_source installed-metadata)
else()
  unset(_verifier CACHE)
  find_program(_verifier NAMES gh gh.exe)
  set(_path_source PATH)
endif()

if(NOT _verifier OR NOT EXISTS "${_verifier}")
  set(_reason "verifier executable unavailable")
  _verifier_finish(REQUIRE_VERIFIED)
endif()
if(IS_DIRECTORY "${_verifier}")
  set(_backend error)
  set(_capability error)
  set(_reason "verifier executable path is a directory")
  _verifier_finish(TRUE)
endif()
if(NOT IS_ABSOLUTE "${_verifier}")
  set(_backend error)
  set(_capability error)
  set(_reason "verifier executable path must be absolute")
  _verifier_finish(TRUE)
endif()
get_filename_component(_verifier_name "${_verifier}" NAME)
string(TOLOWER "${_verifier_name}" _verifier_name)
if(NOT _test_mode AND NOT _verifier_name MATCHES "^gh(\.exe)?$")
  set(_backend error)
  set(_capability error)
  set(_reason "production verifier executable identity is not gh")
  _verifier_finish(TRUE)
endif()

set(_command)
_verifier_append_arguments(_command "${_verifier}")
if(_test_mode)
  if(NOT EXISTS "${TEST_VERIFIER_SCRIPT}" OR IS_DIRECTORY "${TEST_VERIFIER_SCRIPT}")
    set(_backend error)
    set(_capability error)
    set(_reason "test verifier fixture is missing")
    _verifier_finish(TRUE)
  endif()
  if(NOT DEFINED TEST_VERIFIER_MODE OR TEST_VERIFIER_MODE STREQUAL "")
    set(TEST_VERIFIER_MODE valid)
  endif()
  _verifier_append_arguments(_command
    "-DFAKE_MODE=${TEST_VERIFIER_MODE}"
    "-DFAKE_REPOSITORY=${EXPECTED_SOURCE_REPOSITORY}"
    "-DFAKE_REVISION=${EXPECTED_SOURCE_REVISION}"
    "-DFAKE_SUBJECT_DIGEST=${EXPECTED_SUBJECT_DIGEST}"
    "-DFAKE_SUBJECT_NAME=${EXPECTED_SUBJECT_NAME}"
    "-DFAKE_WORKFLOW=${EXPECTED_WORKFLOW_IDENTITY}"
    "-DFAKE_TRUST_DOMAIN=${EXPECTED_TRUST_DOMAIN}"
    -P "${TEST_VERIFIER_SCRIPT}" --)
endif()

_verifier_capture_identity(_reason)
if(_reason)
  set(_backend error)
  set(_capability error)
  set(_verification rejected)
  _verifier_finish(TRUE)
endif()
set(_version_command "${_command}")
_verifier_append_arguments(_version_command --version)
_verifier_capture(text _version_result _version_out _version_err ${_version_command})
_verifier_require_capture("version probe" "verifier version probe timed out")
string(REGEX REPLACE "[ \t\r\n]+$" "" _version_out "${_version_out}")
if(NOT _version_result EQUAL 0
   OR NOT _version_out MATCHES "^gh version ([0-9]+\.[0-9]+\.[0-9]+)([ \r\n]|$)")
  set(_backend error)
  set(_capability error)
  set(_version_policy error)
  set(_reason "malformed verifier version output")
  _verifier_finish(TRUE)
endif()
set(_version "${CMAKE_MATCH_1}")
set(_backend_id github-cli-attestation)

set(_help_command "${_command}")
_verifier_append_arguments(_help_command attestation --help)
_verifier_capture(text _attestation_result _attestation_out _attestation_err ${_help_command})
_verifier_require_capture("attestation probe" "verifier capability probe timed out")
set(_help_command "${_command}")
_verifier_append_arguments(_help_command attestation verify --help)
_verifier_capture(text _verify_help_result _verify_help_out _verify_help_err ${_help_command})
_verifier_require_capture("verify capability probe" "verifier capability probe timed out")
if(_version VERSION_LESS "2.49.0" OR NOT _version VERSION_LESS "3.0.0")
  set(_backend unsupported)
  set(_capability unsupported)
  set(_version_policy unsupported)
  set(_reason "unsupported GitHub CLI version")
  _verifier_finish(REQUIRE_VERIFIED)
endif()
set(_version_policy supported)
if(NOT _attestation_result EQUAL 0 OR NOT _verify_help_result EQUAL 0
   OR NOT _attestation_out MATCHES "attestation"
   OR NOT _verify_help_out MATCHES "(--format|format)")
  set(_backend unsupported)
  set(_capability unsupported)
  set(_reason "GitHub CLI attestation verification capability unavailable")
  _verifier_finish(REQUIRE_VERIFIED)
endif()
set(_backend available)
set(_capability available)

if(PROBE_ONLY)
  set(_reason "probe completed; no attestation supplied")
  _verifier_finish(FALSE)
endif()

foreach(_required IN ITEMS ARTIFACT_PATH EXPECTED_SOURCE_REPOSITORY
    EXPECTED_SOURCE_REVISION EXPECTED_SUBJECT_DIGEST EXPECTED_WORKFLOW_IDENTITY
    EXPECTED_TRUST_DOMAIN ATTESTATION_REFERENCE)
  if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
    set(_backend error)
    set(_verification rejected)
    set(_reason "${_required} is required for cryptographic verification")
    _verifier_finish(TRUE)
  endif()
endforeach()
set(_subject_digest "${EXPECTED_SUBJECT_DIGEST}")
set(_source_repository "${EXPECTED_SOURCE_REPOSITORY}")
set(_source_revision "${EXPECTED_SOURCE_REVISION}")
set(_attestation_reference "${ATTESTATION_REFERENCE}")
set(_trust_domain "${EXPECTED_TRUST_DOMAIN}")

if(NOT IS_ABSOLUTE "${ARTIFACT_PATH}" OR NOT EXISTS "${ARTIFACT_PATH}"
   OR IS_DIRECTORY "${ARTIFACT_PATH}" OR IS_SYMLINK "${ARTIFACT_PATH}")
  set(_verification rejected)
  set(_reason "artifact path is missing, unsafe, or not a regular absolute path")
  _verifier_finish(TRUE)
endif()
if(NOT EXPECTED_SOURCE_REPOSITORY MATCHES
    "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
  set(_verification rejected)
  set(_reason "source repository is unsafe")
  _verifier_finish(TRUE)
endif()
if(NOT EXPECTED_SOURCE_REVISION MATCHES "^[0-9a-f]+$")
  set(_verification rejected)
  set(_reason "source revision is not lowercase hexadecimal")
  _verifier_finish(TRUE)
endif()
string(LENGTH "${EXPECTED_SOURCE_REVISION}" _revision_length)
if(NOT _revision_length EQUAL 40)
  set(_verification rejected)
  set(_reason "source revision is not a full Git SHA")
  _verifier_finish(TRUE)
endif()
if(NOT EXPECTED_SUBJECT_DIGEST MATCHES "^sha256:[0-9a-f]+$")
  set(_verification rejected)
  set(_reason "subject digest must use SHA-256")
  _verifier_finish(TRUE)
endif()
string(LENGTH "${EXPECTED_SUBJECT_DIGEST}" _digest_length)
if(NOT _digest_length EQUAL 71)
  set(_verification rejected)
  set(_reason "subject digest must contain 64 lowercase hexadecimal digits")
  _verifier_finish(TRUE)
endif()
if(NOT EXPECTED_WORKFLOW_IDENTITY MATCHES
    "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/\.github/workflows/[A-Za-z0-9_.-]+\.ya?ml$")
  set(_verification rejected)
  set(_reason "workflow identity is unsafe")
  _verifier_finish(TRUE)
endif()
if(NOT EXPECTED_TRUST_DOMAIN STREQUAL "https://token.actions.githubusercontent.com")
  set(_verification rejected)
  set(_reason "trust domain is unsupported")
  _verifier_finish(TRUE)
endif()
if(NOT ATTESTATION_REFERENCE MATCHES
    "^https://github\.com/${EXPECTED_SOURCE_REPOSITORY}/attestations/[1-9][0-9]*$")
  set(_verification rejected)
  set(_reason "attestation reference does not match the source repository")
  _verifier_finish(TRUE)
endif()
if(DEFINED ATTESTATION_BUNDLE AND NOT ATTESTATION_BUNDLE STREQUAL "")
  if(NOT IS_ABSOLUTE "${ATTESTATION_BUNDLE}" OR NOT EXISTS "${ATTESTATION_BUNDLE}"
     OR IS_DIRECTORY "${ATTESTATION_BUNDLE}" OR IS_SYMLINK "${ATTESTATION_BUNDLE}")
    set(_verification rejected)
    set(_reason "attestation bundle path is missing or unsafe")
    _verifier_finish(TRUE)
  endif()
endif()

file(SHA256 "${ARTIFACT_PATH}" _artifact_sha)
if(NOT "sha256:${_artifact_sha}" STREQUAL EXPECTED_SUBJECT_DIGEST)
  set(_verification rejected)
  set(_reason "artifact subject digest mismatch")
  _verifier_finish(TRUE)
endif()
if(NOT DEFINED EXPECTED_SUBJECT_NAME OR EXPECTED_SUBJECT_NAME STREQUAL "")
  get_filename_component(EXPECTED_SUBJECT_NAME "${ARTIFACT_PATH}" NAME)
endif()
if(NOT EXPECTED_SUBJECT_NAME MATCHES
    "^[A-Za-z0-9][A-Za-z0-9._+-]*(/[A-Za-z0-9][A-Za-z0-9._+-]*)*$")
  set(_verification rejected)
  set(_reason "artifact subject name is unsafe")
  _verifier_finish(TRUE)
endif()

set(_verify_command "${_command}")
_verifier_append_arguments(_verify_command attestation verify "${ARTIFACT_PATH}"
  --repo "${EXPECTED_SOURCE_REPOSITORY}"
  --signer-workflow "${EXPECTED_WORKFLOW_IDENTITY}"
  --source-digest "${EXPECTED_SOURCE_REVISION}"
  --cert-oidc-issuer "${EXPECTED_TRUST_DOMAIN}"
  --predicate-type "https://slsa.dev/provenance/v1"
  --deny-self-hosted-runners --limit 2 --format json)
if(DEFINED ATTESTATION_BUNDLE AND NOT ATTESTATION_BUNDLE STREQUAL "")
  _verifier_append_arguments(_verify_command --bundle "${ATTESTATION_BUNDLE}")
endif()
_verifier_capture(json _verify_result _verify_out _verify_err ${_verify_command})
_verifier_require_capture("verification output" "verifier process timed out")
if(NOT _verify_result EQUAL 0)
  if(_verify_err MATCHES "[Nn]o attestations found|attestation missing")
    set(_verification unavailable)
    set(_reason "attestation unavailable")
  else()
    set(_verification rejected)
    set(_reason "verifier rejected the attestation")
  endif()
  _verifier_finish(REQUIRE_VERIFIED)
endif()

_verifier_check_json_members("${_verify_out}" _json_rejection)
if(_json_rejection)
  set(_backend error)
  set(_verification rejected)
  set(_reason "${_json_rejection}")
  _verifier_finish(TRUE)
endif()

string(JSON _result_type ERROR_VARIABLE _json_error TYPE "${_verify_out}")
if(_json_error OR NOT _result_type STREQUAL "ARRAY")
  set(_backend error)
  set(_verification rejected)
  set(_reason "malformed machine-readable verifier output")
  _verifier_finish(TRUE)
endif()
string(JSON _result_count LENGTH "${_verify_out}")
if(NOT _result_count EQUAL 1)
  set(_verification rejected)
  set(_reason "multiple or missing attestation results are ambiguous")
  _verifier_finish(TRUE)
endif()
foreach(_unique IN ITEMS verificationResult predicateType sourceRepositoryURI
    sourceRepositoryDigest buildSignerURI verifiedTimestamps)
  string(REGEX MATCHALL "\"${_unique}\"[ \t\r\n]*:" _matches "${_verify_out}")
  list(LENGTH _matches _match_count)
  if(NOT _match_count EQUAL 1)
    set(_backend error)
    set(_verification rejected)
    set(_reason "duplicate or missing JSON field: ${_unique}")
    _verifier_finish(TRUE)
  endif()
endforeach()

string(JSON _predicate ERROR_VARIABLE _field_error GET "${_verify_out}"
  0 verificationResult statement predicateType)
if(_field_error OR NOT _predicate STREQUAL "https://slsa.dev/provenance/v1")
  set(_verification rejected)
  set(_reason "unsupported attestation predicate type")
  _verifier_finish(TRUE)
endif()
string(JSON _subject_count ERROR_VARIABLE _field_error LENGTH "${_verify_out}"
  0 verificationResult statement subject)
if(_field_error OR _subject_count LESS 1)
  set(_verification rejected)
  set(_reason "attestation subject is missing")
  _verifier_finish(TRUE)
endif()
set(_subject_matches 0)
math(EXPR _subject_last "${_subject_count} - 1")
foreach(_index RANGE 0 ${_subject_last})
  string(JSON _name ERROR_VARIABLE _subject_error GET "${_verify_out}"
    0 verificationResult statement subject ${_index} name)
  string(JSON _digest ERROR_VARIABLE _digest_error GET "${_verify_out}"
    0 verificationResult statement subject ${_index} digest sha256)
  if(NOT _subject_error AND NOT _digest_error
     AND _name STREQUAL EXPECTED_SUBJECT_NAME
     AND "sha256:${_digest}" STREQUAL EXPECTED_SUBJECT_DIGEST)
    math(EXPR _subject_matches "${_subject_matches} + 1")
  endif()
endforeach()
if(NOT _subject_matches EQUAL 1)
  set(_verification rejected)
  set(_reason "attestation subject name or digest mismatch")
  _verifier_finish(TRUE)
endif()

foreach(_field IN ITEMS sourceRepositoryURI sourceRepositoryDigest buildSignerURI
    issuer)
  string(JSON _certificate_${_field} ERROR_VARIABLE _field_error GET "${_verify_out}"
    0 verificationResult signature certificate ${_field})
  if(_field_error)
    set(_verification rejected)
    set(_reason "unsigned or malformed verifier result")
    _verifier_finish(TRUE)
  endif()
endforeach()
if(NOT _certificate_sourceRepositoryURI STREQUAL
    "https://github.com/${EXPECTED_SOURCE_REPOSITORY}")
  set(_verification rejected)
  set(_reason "verified repository or owner mismatch")
  _verifier_finish(TRUE)
endif()
if(NOT _certificate_sourceRepositoryDigest STREQUAL EXPECTED_SOURCE_REVISION)
  set(_verification rejected)
  set(_reason "verified source revision mismatch")
  _verifier_finish(TRUE)
endif()
string(FIND "${_certificate_buildSignerURI}"
  "https://github.com/${EXPECTED_WORKFLOW_IDENTITY}@" _workflow_position)
if(NOT _workflow_position EQUAL 0)
  set(_verification rejected)
  set(_reason "verified workflow identity mismatch")
  _verifier_finish(TRUE)
endif()
string(JSON _certificate_runner_type ERROR_VARIABLE _runner_error TYPE "${_verify_out}"
  0 verificationResult signature certificate runnerEnvironment)
if(_runner_error)
  set(_verification rejected)
  set(_reason "missing certificate runnerEnvironment")
  _verifier_finish(TRUE)
endif()
string(JSON _certificate_runner GET "${_verify_out}"
  0 verificationResult signature certificate runnerEnvironment)
if(NOT _certificate_runner_type STREQUAL "STRING" OR NOT _certificate_runner STREQUAL "github-hosted")
  set(_verification rejected)
  set(_reason "self-hosted attestation is forbidden")
  _verifier_finish(TRUE)
endif()

string(JSON _identity_type ERROR_VARIABLE _identity_error TYPE "${_verify_out}"
  0 verificationResult verifiedIdentity)
if(NOT _identity_error)
  string(JSON _identity_runner_type ERROR_VARIABLE _identity_runner_error TYPE "${_verify_out}"
    0 verificationResult verifiedIdentity runnerEnvironment)
  if(_identity_type STREQUAL "OBJECT" AND NOT _identity_runner_error
     AND _identity_runner_type STREQUAL "STRING")
    string(JSON _identity_runner GET "${_verify_out}"
      0 verificationResult verifiedIdentity runnerEnvironment)
  else()
    set(_identity_runner "")
  endif()
  if(NOT _identity_runner STREQUAL "github-hosted")
    set(_verification rejected)
    set(_reason "invalid verifiedIdentity runnerEnvironment")
    _verifier_finish(TRUE)
  endif()
endif()

if(NOT _certificate_issuer STREQUAL EXPECTED_TRUST_DOMAIN)
  set(_verification rejected)
  set(_reason "verified trust domain mismatch")
  _verifier_finish(TRUE)
endif()
string(JSON _timestamp_count ERROR_VARIABLE _timestamp_error LENGTH "${_verify_out}"
  0 verificationResult verifiedTimestamps)
if(_timestamp_error OR _timestamp_count LESS 1)
  set(_verification rejected)
  set(_reason "verified timestamp is missing")
  _verifier_finish(TRUE)
endif()

set(_verification verified)
set(_reason "verification succeeded")
_verifier_finish(FALSE)
