cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED ROOT OR ROOT STREQUAL "" OR NOT IS_DIRECTORY "${ROOT}")
  message(FATAL_ERROR "ROOT must name an existing delivery asset directory")
endif()
if(NOT DEFINED OUTPUT_NAME OR OUTPUT_NAME STREQUAL "")
  set(OUTPUT_NAME "SHA256SUMS.txt")
endif()
if(OUTPUT_NAME MATCHES "[/\\\\]" OR OUTPUT_NAME STREQUAL "." OR OUTPUT_NAME STREQUAL "..")
  message(FATAL_ERROR "OUTPUT_NAME must be a simple file name")
endif()

file(REAL_PATH "${ROOT}" _root)
set(_output "${_root}/${OUTPUT_NAME}")
file(GLOB _assets LIST_DIRECTORIES false RELATIVE "${_root}" "${_root}/*")
list(FILTER _assets EXCLUDE REGEX "^${OUTPUT_NAME}$")
if(NOT _assets)
  message(FATAL_ERROR "No delivery assets found under ${_root}")
endif()
list(SORT _assets)
set(_content "")
foreach(_path IN LISTS _assets)
  if(_path MATCHES "\\\\" OR _path MATCHES "(^|/)\\.\\.(/|$)")
    message(FATAL_ERROR "Delivery asset path is not normalized: ${_path}")
  endif()
  file(SHA256 "${_root}/${_path}" _hash)
  string(APPEND _content "${_hash}  ${_path}\n")
endforeach()
file(WRITE "${_output}.tmp" "${_content}")
file(RENAME "${_output}.tmp" "${_output}")
message(STATUS "Generated ${_output}")
