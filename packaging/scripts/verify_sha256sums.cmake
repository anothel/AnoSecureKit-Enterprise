cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED ROOT OR ROOT STREQUAL "" OR NOT IS_DIRECTORY "${ROOT}")
  message(FATAL_ERROR "ROOT must name an existing delivery asset directory")
endif()
if(NOT DEFINED INPUT_NAME OR INPUT_NAME STREQUAL "")
  set(INPUT_NAME "SHA256SUMS.txt")
endif()

file(REAL_PATH "${ROOT}" _root)
set(_input "${_root}/${INPUT_NAME}")
if(NOT EXISTS "${_input}")
  message(FATAL_ERROR "Missing checksum file: ${_input}")
endif()
file(STRINGS "${_input}" _lines ENCODING UTF-8)
if(NOT _lines)
  message(FATAL_ERROR "Checksum file is empty: ${_input}")
endif()

set(_paths)
foreach(_line IN LISTS _lines)
  string(REGEX MATCH "^([0-9a-f]+)  (.+)$" _match "${_line}")
  if(NOT _match)
    message(FATAL_ERROR "Malformed checksum entry: ${_line}")
  endif()
  set(_expected "${CMAKE_MATCH_1}")
  set(_path "${CMAKE_MATCH_2}")
  string(LENGTH "${_expected}" _hash_length)
  if(NOT _hash_length EQUAL 64)
    message(FATAL_ERROR "Invalid SHA-256 value for ${_path}")
  endif()
  if(_path STREQUAL "${INPUT_NAME}"
      OR _path MATCHES "\\\\"
      OR _path MATCHES "^[A-Za-z]:"
      OR _path MATCHES "(^|/)\\.\\.(/|$)")
    message(FATAL_ERROR "Checksum path is unsafe or not normalized: ${_path}")
  endif()
  list(FIND _paths "${_path}" _duplicate)
  if(NOT _duplicate EQUAL -1)
    message(FATAL_ERROR "Duplicate checksum path: ${_path}")
  endif()
  list(APPEND _paths "${_path}")
  if(NOT EXISTS "${_root}/${_path}" OR IS_DIRECTORY "${_root}/${_path}")
    message(FATAL_ERROR "Missing delivery asset: ${_path}")
  endif()
  file(SHA256 "${_root}/${_path}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "Checksum mismatch: ${_path}")
  endif()
endforeach()
set(_sorted "${_paths}")
list(SORT _sorted)
if(NOT "${_paths}" STREQUAL "${_sorted}")
  message(FATAL_ERROR "Checksum entries are not sorted")
endif()
message(STATUS "Verified ${_input}")
